/* ------------------------------------------------------------------------- */

void TerminalDisplay::setFlowControlWarningEnabled( bool enable )
{
	_flowControlWarningEnabled = enable;
	
	// if the dialog is currently visible and the flow control warning has 
	// been disabled then hide the dialog
	if (!enable)
		outputSuspended(false);
}

// ---------------------------------------------------------------------------
// Term50-style key layer, ported from Term50's metamode/chord scheme.
//
// The on-screen soft-key bar (Ctrl+ / Tab / < / > / ^ / v / Esc) is gone.
// The right Shift is the Ctrl key, hold-only: press and hold it, hit a key,
// release.  No sticky layer, no badge, no waiting - a latched layer that
// hijacked e (Esc), v (paste) and i/o (font size) was far too easy to trip
// by accident on a phone keypad, and the CTRL badge it lit sat in the corner
// until it was double-tapped again, which read as "the terminal is stuck".
// ---------------------------------------------------------------------------
// How long after a commit an auto-repeating key still counts as part of
// the word that was just committed (see handleImeKey).
#define IME_COMMIT_GUARD_MS    400
#define META_DEFAULT_FONT_SIZE 22

// QNX keycode of the BB10 SYM key (Term50 src/terminal.h KEYCODE_BB_SYM_KEY).
// Qt has no mapping for it, so it arrives as an unmapped key / bare Escape.
#define TD_KEYCODE_BB_SYM      0xF0D3

// Every byte the terminal produces for the shell goes through here.
//
// It used to write straight to gActiveFd, the pty of whichever tab happened
// to be in front at the moment of the write.  That is fine for a keystroke
// that is handled the instant it arrives, but not for anything that was
// already sitting in the event queue when the user switched tabs: a key
// pressed just before the switch could be typed into the *new* tab's shell.
// Each display now owns a pointer to its own session and writes there.
void TerminalDisplay::writeInputBytes(const char *b, int n)
{
	if (n <= 0)
		return;
	if (_inputSession) {
		_inputSession->send(b, n);
		return;
	}
	// No session attached (should not happen for tab widgets): keep the old
	// behaviour so nothing silently stops working.
	if (gActiveFd >= 0)
		write(gActiveFd, b, n);
}

// True when this key event comes from the right-hand Shift key. On BB10 both
// Shift keys arrive as Qt::Key_Shift; the QNX keycode carried in
// nativeVirtualKey()/nativeScanCode() tells them apart.
static bool td_isRightShift(QKeyEvent *event)
{
#ifdef __QNXNTO__
	const int nv = event->nativeVirtualKey();
	const int ns = event->nativeScanCode();
	return nv == KEYCODE_RIGHT_SHIFT || ns == KEYCODE_RIGHT_SHIFT;
#else
	Q_UNUSED(event);
	return false;
#endif
}

// Send Ctrl+<key> for the key being held down while right Shift is held.
void TerminalDisplay::sendCtrlKey(QKeyEvent *event)
{
	const int key = event->key();
	unsigned char c = 0;

	switch (key) {
	case Qt::Key_Left:     { const char s[] = {0x1b, '[', '1', ';', '5', 'D'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Right:    { const char s[] = {0x1b, '[', '1', ';', '5', 'C'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Up:       { const char s[] = {0x1b, '[', '1', ';', '5', 'A'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Down:     { const char s[] = {0x1b, '[', '1', ';', '5', 'B'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Home:     { const char s[] = {0x1b, '[', '1', ';', '5', 'H'}; writeInputBytes(s, 6); return; }
	case Qt::Key_End:      { const char s[] = {0x1b, '[', '1', ';', '5', 'F'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Delete:   { const char s[] = {0x1b, '[', '3', ';', '5', '~'}; writeInputBytes(s, 6); return; }
	case Qt::Key_PageUp:   { const char s[] = {0x1b, '[', '5', ';', '5', '~'}; writeInputBytes(s, 6); return; }
	case Qt::Key_PageDown: { const char s[] = {0x1b, '[', '6', ';', '5', '~'}; writeInputBytes(s, 6); return; }
	case Qt::Key_Return:
	case Qt::Key_Enter:    c = 0x0d; break;
	case Qt::Key_Backspace:c = 0x08; break;
	case Qt::Key_Tab:      c = 0x09; break;
	case Qt::Key_Escape:   c = 0x1b; break;
	case Qt::Key_Space:    { const char z = 0; writeInputBytes(&z, 1); return; }
	default:
		// A-Z, [ \ ] ^ _ all live in 0x40..0x5f, and Ctrl+<key> is key-0x40
		// (Ctrl+C = 0x03, Ctrl+D = 0x04, Ctrl+] = 0x1d ...)
		if (key >= 0x40 && key <= 0x5f)
			c = (unsigned char)(key - 0x40);
		break;
	}

	if (c)
		writeInputBytes((const char *)&c, 1);
}

void TerminalDisplay::setMetaLayer(bool on)
{
	_metaArmed = on;

	if (!_metaBadge) {
		_metaBadge = new QLabel(this);
		_metaBadge->setText(QString("CTRL"));
		// Same treatment as a pressed keycap: solid accent, dark ink.  The
		// old black plate with a neon outline was the last survivor of the
		// palette the key strip used to carry.
		_metaBadge->setStyleSheet(QString(
		    "QLabel { background-color: %1; color: %2; border: 1px solid %1;"
		    " border-radius: 6px; padding: 2px 8px; font-weight: bold;"
		    " letter-spacing: 1px; }")
		    .arg(UiTheme::hex(UiTheme::Accent),
		         UiTheme::hex(UiTheme::AccentInk)));
		_metaBadge->setAttribute(Qt::WA_TransparentForMouseEvents, true);
		_metaBadge->setFocusPolicy(Qt::NoFocus);
		_metaBadge->adjustSize();
	}
	if (on) {
		_metaBadge->adjustSize();
		_metaBadge->move(rect().width() - _metaBadge->width() - 8,
		                rect().height() - _metaBadge->height() - 8);
		_metaBadge->raise();
	}
	_metaBadge->setVisible(on);
	update();
}

void TerminalDisplay::applyFontPixelSize(int px)
{
	if (px < 10) px = 10;
	if (px > 60) px = 60;

	if (mainWindow)
		mainWindow->nFontSize = px;

	QSettings settings;
	settings.setValue(QString("FontSize"), px);

	// The bundled Maple Mono subset covers ASCII *and* GB2312 with an exact
	// 2:1 advance ratio, which is what the double width cells assume.
	const QString family = gTerminalFontFamily.isEmpty()
	                       ? QString("Courier New") : gTerminalFontFamily;
	QFont newfont = QFont(family, 6);
	newfont.setPixelSize(px);
	newfont.setStyle(QFont::StyleNormal);
	newfont.setWeight(QFont::Normal);
	setVTFont(newfont);

	if (_metaBadge && _metaArmed)
		_metaBadge->raise();
}

void TerminalDisplay::showBindingHelp()
{
	QString help;
	help += QString::fromUtf8("实体键盘上 Shift 就是 Ctrl 键\n");
	help += QString::fromUtf8("（BB10 手机没有方向键，印着上箭头的那个键就是 Shift）\n\n");
	help += QString::fromUtf8("  按住右 Shift + <键> -> Ctrl + <键>\n");
	help += QString::fromUtf8("      c=Ctrl+C  d=Ctrl+D  z=Ctrl+Z  l=Ctrl+L\n");
	help += QString::fromUtf8("      Esc = Ctrl+[   Tab = Ctrl+I\n");
	help += QString::fromUtf8("  松开右 Shift 立即恢复普通输入（无锁定、无等待）\n");
	help += QString::fromUtf8("  左 Shift 始终是普通 Shift\n\n");
	help += QString::fromUtf8("SYM = 符号面板（点格子，或按对应字母）\n");
	help += QString::fromUtf8("      q~ w` e{ r} t[ y] u< i> o^ p%\n");
	help += QString::fromUtf8("      a= s- d* f/ g\\ h| j& k' l\"\n");
	help += QString::fromUtf8("     底部：Esc / Tab / Shift+Tab\n\n");
	help += QString::fromUtf8("Alt+Enter = 中文/EN 输入法   Alt+Space = Tab\n");
	help += QString::fromUtf8("Ctrl+Space = 同样的输入法开关\n");
	help += QString::fromUtf8("Shift+Alt+<键> = Ctrl+<键>\n\n");
	help += QString::fromUtf8("下滑菜单 -> 命令 / SSH：保存的常用命令与主机\n");
	help += QString::fromUtf8("     上滑收回，或点一下终端\n");
	help += QString::fromUtf8("  点一行，然后 运行 / 仅插入 / 连接\n");
	help += QString::fromUtf8("  连接自带 30 秒保活，掉线后顶部出现 重连 横条\n\n");
	help += QString::fromUtf8("粘贴多行内容会先问一次：\n");
	help += QString::fromUtf8("  原样粘贴（逐行执行）/ 合并成一行 / 取消\n");
	help += QString::fromUtf8("设置里可改回滚缓冲行数（500 - 10000）\n\n");
	help += QString::fromUtf8("触屏手势：\n");
	help += QString::fromUtf8("  长按屏幕    选中该行并弹出 复制 / 粘贴 菜单\n");
	help += QString::fromUtf8("  长按后拖动  扩展选区\n");
	help += QString::fromUtf8("  两指上下滑  翻看历史输出\n");
	help += QString::fromUtf8("  两指捏合/张开  缩小 / 放大字体（会记住）\n\n");
	help += QString::fromUtf8("拼音输入法（Alt+Enter，左上角出现 中 标记）：\n");
	help += QString::fromUtf8("  a-z     输入拼音（可整词：nihao -> 你好）\n");
	help += QString::fromUtf8("  1-8     选候选字    Space  取高亮候选\n");
	help += QString::fromUtf8("  = . >   下一页      - , <  上一页\n");
	help += QString::fromUtf8("          （候选条有第二页时才有效）\n");
	help += QString::fromUtf8("  点      候选条上的候选字 / < > 箭头\n");
	help += QString::fromUtf8("          候选条占终端下方两行，不遮住光标行\n");
	help += QString::fromUtf8("  Enter   按英文字母直接上屏（不切换）\n");
	help += QString::fromUtf8("  Esc     放弃组字（什么都不发送）\n");
	help += QString::fromUtf8("  触控板（Q20/Q10/Q5/Classic）：左右选候选，\n");
	help += QString::fromUtf8("           上下翻页，按下即上屏\n\n");
	help += QString::fromUtf8("字体：%1   输入法：%2（字体随包，未安装到系统）\n\n")
	         .arg(gTerminalFontFamily.isEmpty() ? QString::fromUtf8("Courier New（未找到中文字形）")
	                                            : gTerminalFontFamily)
	         .arg(_imeOn ? QString::fromUtf8("中文") : QString("EN"));
	help += QString::fromUtf8("最后按下的 Shift：native=0x%1 scan=0x%2 右Shift=%3\n")
	         .arg(_lastShiftNative, 0, 16)
	         .arg(_lastShiftScan, 0, 16)
	         .arg(_lastShiftWasRight ? QString::fromUtf8("是") : QString::fromUtf8("否"));

	// A plain message box would clip the bottom of this much text on the
	// 720x720 screen, so the help gets its own scrollable window.
	QDialog dlg(this);
	dlg.setWindowTitle(QString::fromUtf8("按键说明"));
	dlg.setStyleSheet(QString("QDialog { background-color: %1; }")
	                      .arg(UiTheme::hex(UiTheme::Bg)));

	QVBoxLayout *lay = new QVBoxLayout(&dlg);
	lay->setContentsMargins(20, 16, 20, 18);
	lay->setSpacing(14);

	lay->addWidget(UiTheme::newHeader(&dlg, QString::fromUtf8("按键说明"),
	                                  QString::fromUtf8("上下滑动查看全部")));

	QPlainTextEdit *view = new QPlainTextEdit(&dlg);
	view->setReadOnly(true);
	view->setPlainText(help);
	view->setLineWrapMode(QPlainTextEdit::NoWrap);
	view->setFrameShape(QFrame::NoFrame);

	QFont hf = UiTheme::monoFont(18);
	view->setFont(hf);
	lay->addWidget(view, 1);

	QPushButton *btnClose = new QPushButton(QString::fromUtf8("关闭"), &dlg);
	btnClose->setObjectName(QString("primary"));
	btnClose->setMinimumHeight(72);
	btnClose->setFocusPolicy(Qt::NoFocus);
	lay->addWidget(btnClose);
	connect(btnClose, SIGNAL(clicked()), &dlg, SLOT(accept()));

	dlg.resize(qMin(width() - 40, 900), qMin(height() - 40, 1200));
	dlg.exec();
}

void TerminalDisplay::handleMetaKey(QKeyEvent *event)
{
	const int key = event->key();
	unsigned char c = 0;
	bool keep = false;

	switch (key) {
	/* --- Term50 metamode_keys: sticky arrow keys (k/j/l/h) ------------- */
	case Qt::Key_H: { const char s[] = {0x1b, '[', 'D'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_J: { const char s[] = {0x1b, '[', 'B'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_K: { const char s[] = {0x1b, '[', 'A'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_L: { const char s[] = {0x1b, '[', 'C'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_Left:  { const char s[] = {0x1b, '[', 'D'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_Right: { const char s[] = {0x1b, '[', 'C'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_Up:    { const char s[] = {0x1b, '[', 'A'}; writeInputBytes(s, 3); keep = true; break; }
	case Qt::Key_Down:  { const char s[] = {0x1b, '[', 'B'}; writeInputBytes(s, 3); keep = true; break; }

	/* --- Term50 metamode_keys: one-shot actions ----------------------- */
	case Qt::Key_E: c = 0x1b; break;                       /* Esc             */
	case Qt::Key_S: c = 0x0c; break;                       /* rescreen ~ C-L  */
	case Qt::Key_V: pasteClipboard(); break;               /* paste_clipboard */
	case Qt::Key_I: applyFontPixelSize(mainWindow->nFontSize + 2); break;
	case Qt::Key_O: applyFontPixelSize(mainWindow->nFontSize - 2); break;
	case Qt::Key_Z: applyFontPixelSize(META_DEFAULT_FONT_SIZE);    break;
	case Qt::Key_R: {                                      /* reload_config   */
		QSettings settings;
		int fs = settings.value(QString("FontSize")).toInt();
		applyFontPixelSize(fs > 0 ? fs : META_DEFAULT_FONT_SIZE);
		break;
	}
	case Qt::Key_Question: showBindingHelp(); break;        /* help_overlay    */

	/* --- plain control characters ------------------------------------- */
	case Qt::Key_Escape:    c = 0x1b; break;
	case Qt::Key_Tab:       c = 0x09; break;
	case Qt::Key_Return:
	case Qt::Key_Enter:     c = 0x0d; break;
	case Qt::Key_Backspace: c = 0x7f; break;

	default:
		/* Ctrl+<key>: A-Z as well as [ \ ] ^ _ all sit in 0x40..0x5f and
		 * Ctrl+<key> is key-0x40 (Ctrl+C = 0x03, Ctrl+] = 0x1d). */
		if (key >= 0x40 && key <= 0x5f)
			c = (unsigned char)(key - 0x40);
		break;
	}

	if (c)
		writeInputBytes((const char *)&c, 1);
	if (!keep)
		setMetaLayer(false);
	event->accept();
}

// ---------------------------------------------------------------------------
// Term50 symmenu overlay (SYM key). The grid itself lives in symbolpanel.cpp.
// ---------------------------------------------------------------------------
void TerminalDisplay::showSymbolPanel()
{
	if (!_symPanel) {
		_symPanel = new CSymbolPanel(this);
		connect(_symPanel, SIGNAL(symbolChosen(QString)),
		        this, SLOT(onSymbolChosen(QString)));
		connect(_symPanel, SIGNAL(controlKeyChosen(QString,bool)),
		        this, SLOT(onSymbolControlKey(QString,bool)));
	}
	_symPanel->popup();
}

void TerminalDisplay::closeSymbolPanel()
{
	if (_symPanel)
		_symPanel->dismiss();
	setFocus();
}

// Esc / Tab / Shift+Tab tapped in the symbol grid: raw bytes to the pty.
// Tab keeps the grid up so it can be tapped a few times in a row.
void TerminalDisplay::onSymbolControlKey(const QString &bytes, bool keepOpen)
{
	const QByteArray raw = bytes.toUtf8();
	writeInputBytes(raw.constData(), raw.size());
	if (keepOpen)
		setFocus();
	else
		closeSymbolPanel();
}

void TerminalDisplay::insertSymbolText(const QString &text)
{
	const QByteArray utf8 = text.toUtf8();
	writeInputBytes(utf8.constData(), utf8.size());
	closeSymbolPanel();
}

void TerminalDisplay::onSymbolChosen(const QString &text)
{
	insertSymbolText(text);
}

// ---------------------------------------------------------------------------
// Chinese input method (Alt+Enter). The engine is Term50's own cjk_ime.c
// (copied in from src/Term50/src), so phrases ("nihao" -> 你好), syllable
// segmentation ("woaini") and the learned candidate order are identical to
// Term50. The candidate strip is imepanel.cpp.
// ---------------------------------------------------------------------------
static int imeSymForEvent(QKeyEvent *event)
{
	switch (event->key()) {
	case Qt::Key_Escape:    return 0x1b;
	case Qt::Key_Backspace: return 0x7f;
	case Qt::Key_Return:
	case Qt::Key_Enter:     return '\r';
	case Qt::Key_Space:     return ' ';
	default: break;
	}

	const QString text = event->text();
	if (text.size() == 1) {
		const ushort u = text.at(0).unicode();
		if (u < 0x80)
			return (int)u;          // a-z, 1-9, - = , . [ ] and friends
	}
	if (event->key() >= Qt::Key_A && event->key() <= Qt::Key_Z)
		return 'a' + (event->key() - Qt::Key_A);
	return 0;
}

// `,` `.` `-` `[` `]` `=` are cjk_ime's page keys: while a composition
// runs the engine turns the candidate strip with them. With a single page
// there is nothing to turn, and Term50's engine swallows the key anyway,
// which used to eat the comma of "hello, world". So the widget decides: a
// page key only belongs to the engine when there really is a second page,
// otherwise it is ordinary punctuation (the letters typed so far go out
// first, then the shell gets the key). Kept as a standalone function so
// tests/ can replay the same decision on a normal PC.
static bool imePageKeyHasNoPage(int sym, bool composing, int pageCount)
{
	if (sym != ',' && sym != '.' && sym != '-' &&
	    sym != '[' && sym != ']' && sym != '=')
		return false;              // not a page key at all
	return composing && pageCount <= 1;
}

static QString imePreeditText(cjk_ime_t *ime)
{
	return QString::fromUtf8(cjk_ime_preedit(ime));
}

static QStringList imePageCandidates(cjk_ime_t *ime)
{
	QStringList list;
	const int n = cjk_ime_candidate_count(ime);
	for (int i = 0; i < n; ++i)
		list << QString::fromUtf8(cjk_ime_candidate(ime, i));
	return list;
}

void TerminalDisplay::setImeMode(bool on)
{
	_imeOn = on;

	if (!_ime) {
		_ime = (cjk_ime_t*)calloc(1, sizeof(cjk_ime_t));
		cjk_ime_init(_ime);
	}

	if (!_imePanel) {
		_imePanel = new CImePanel(this);
		_imePanel->setCjkFontFamily(gTerminalFontFamily);
		connect(_imePanel, SIGNAL(candidateChosen(int)),
		        this, SLOT(onImeCandidateChosen(int)));
		connect(_imePanel, SIGNAL(pageRequested(int)),
		        this, SLOT(onImePageRequested(int)));
	}

	cjk_ime_set_enabled(_ime, on ? 1 : 0);

	if (on) {
		// Keep the strip's height free under the last row for as long as the
		// IME is on, not just while a composition runs: reserving and giving
		// the space back on every committed word would resize the pty over
		// and over and make full-screen programs redraw in a loop.
		// Show the strip right away (idle state = the "拼音" hint), so turning
		// the IME on gives immediate feedback instead of a silent two-row gap.
		refreshBottomReserve();
		refreshImePanel();
	}
	else {
		closeImePanel();
		refreshBottomReserve();
	}

	QSettings settings;
	settings.setValue(QString("ImeOn"), on);

	setFocus();
	update();
}

void TerminalDisplay::toggleImeMode()
{
	setImeMode(!_imeOn);
}

/* ------------------------------------------------------------------------- */
/*                        custom key strip                                   */
/* ------------------------------------------------------------------------- */

// The key strip and the candidate strip both live under the last row, the
// candidate strip on top of the key strip. The pty has to know about both, so
// one place adds them up and reports the new row count.
void TerminalDisplay::refreshBottomReserve()
{
	const int keyPx = (_keyBarOn && _keyBar) ? _keyBar->stripHeight() : 0;
	const int imePx = (_imeOn && _imePanel) ? _imePanel->stripHeight() : 0;

	if (_imePanel)
		_imePanel->setBottomOffset(keyPx);

	setBottomReserve(keyPx + imePx);

	if (_keyBar && _keyBarOn)
		_keyBar->popup();
}

void TerminalDisplay::setKeyBarEnabled(bool on)
{
	_keyBarOn = on;

	if (!_keyBar) {
		_keyBar = new CKeyBar(this);
		connect(_keyBar, SIGNAL(keyClicked(QByteArray)),
		        this, SLOT(onKeyBarClicked(QByteArray)));
		_keyBar->setItems(CKeyBar::loadItems());
	}

	if (on) {
		_keyBar->setItems(CKeyBar::loadItems());
		_keyBar->popup();
		_keyBar->raise();
	}
	else {
		_keyBar->dismiss();
	}

	refreshBottomReserve();
	if (_imeOn)
		refreshImePanel();

	QSettings settings;
	settings.setValue(QString("KeyBarOn"), on);

	update();
}

void TerminalDisplay::reloadKeyBar()
{
	if (!_keyBar)
		return;
	_keyBar->setItems(CKeyBar::loadItems());
	_keyBar->update();
}

// A strip button is just a byte sequence; the pty does not care whether it
// came from a key or from a tap.
void TerminalDisplay::onKeyBarClicked(const QByteArray &bytes)
{
	if (bytes.isEmpty())
		return;
	sendToShell(bytes);
}

void TerminalDisplay::closeImePanel()
{
	if (_imePanel)
		_imePanel->dismiss();
}

// The strip is drawn under the last row, not on top of it. Reserving the space
// here makes calcGeometry() compute fewer rows; updateImageSize() then reports
// the new size to the session, so the shell re-wraps exactly like it does when
// the on-screen keyboard slides over the window.
void TerminalDisplay::setBottomReserve(int px)
{
	if (px < 0)
		px = 0;
	if (px == _bottomReserve)
		return;

	_bottomReserve = px;

	if (_image) {
		// Reserving space is not a user resize: keep the size box quiet while
		// recalculating rows/cols (which reports the new size to the session).
		const bool wasSuppressed = _suppressSizeHint;
		_suppressSizeHint = true;
		updateImageSize();
		_suppressSizeHint = wasSuppressed;
		update();
	}
}

void TerminalDisplay::refreshImePanel()
{
	if (!_ime || !_imePanel)
		return;

	// An empty composition no longer hides the strip: the space under the last
	// row is already reserved, so the strip stays as a small "拼音" hint
	// instead of a blank band that appears and disappears at every word.
	const bool idleMode = cjk_ime_preedit(_ime)[0] == '\0';
	_imePanel->setState(idleMode ? QString() : imePreeditText(_ime),
	                    idleMode ? QStringList() : imePageCandidates(_ime),
	                    idleMode ? 0 : cjk_ime_candidate_page(_ime),
	                    idleMode ? 0 : cjk_ime_candidate_page_count(_ime));
	_imePanel->popup();
}

// One key through the engine: 0 = not used, 1 = used (composition changed),
// 2 = a candidate was committed and out/outLen hold its UTF-8.
void TerminalDisplay::sendImeSym(int sym)
{
	if (!_ime)
		return;

	char out[192];
	size_t outLen = 0;
	const int r = cjk_ime_handle_key(_ime, sym, 0, 1, out, sizeof(out), &outLen);

	// The strip is what the eye follows: refresh it first, then write, then
	// repaint the terminal at once so the character is not a round trip late.
	if (r != 0)
		refreshImePanel();
	if (r == 2 && outLen > 0) {
		imeTraceBytes("ime-commit", out, (int)outLen);
		writeInputBytes(out, (int)outLen);
		_imeCommitMs = QDateTime::currentMSecsSinceEpoch();
		update();
	}
}

void TerminalDisplay::onImeCandidateChosen(int index)
{
	// the engine commits through its own number keys, so a tap is "1".."8"
	sendImeSym('1' + index);
}

void TerminalDisplay::onImePageRequested(int delta)
{
	sendImeSym(delta < 0 ? '[' : ']');
}

// The QWERTY BB10 phones (Q20, Q10, Q5) and the Classic have a trackpad
// instead of a touchscreen. Its movement arrives as a JOYSTICK screen event in
// main.cpp, which calls in here first: while a composition runs the strip takes
// it, otherwise the caller sends an arrow key as before.
bool TerminalDisplay::imeTrackpadStep(int dx, int dy)
{
	const bool composing = _imeOn && _ime &&
	                       cjk_ime_preedit(_ime)[0] != '\0';

	// Nothing is being composed: the trackpad belongs to the key strip, so a
	// Q10 / Q20 user can still reach Esc / Ctrl-C without a touchscreen.
	if (!composing) {
		if (_keyBarOn && _keyBar && _keyBar->isOpen()) {
			if (dx != 0) { _keyBar->moveHighlight(dx > 0 ? 1 : -1); return true; }
			if (dy != 0) { _keyBar->moveHighlight(dy > 0 ? 1 : -1); return true; }
		}
		return false;
	}
	if (!_imePanel || !_imePanel->isOpen())
		return false;

	if (dx != 0) {
		_imePanel->moveHighlight(dx > 0 ? 1 : -1);
		return true;
	}
	if (dy != 0) {
		if (cjk_ime_candidate_page_count(_ime) > 1)
			onImePageRequested(dy > 0 ? 1 : -1);   // down = next page
		else
			_imePanel->moveHighlight(dy > 0 ? 1 : -1);
		return true;
	}
	return false;
}

bool TerminalDisplay::imeTrackpadClick()
{
	const bool composing = _imeOn && _ime &&
	                       cjk_ime_preedit(_ime)[0] != '\0';

	if (composing && _imePanel && _imePanel->isOpen()) {
		_imePanel->commitHighlighted();
		return true;
	}
	if (_keyBarOn && _keyBar && _keyBar->isOpen() && _keyBar->hasHighlight()) {
		_keyBar->commitHighlighted();
		return true;
	}
	return false;
}

/* ------------------------------------------------------------------------- */
/*                 Quick commands / saved SSH hosts                          */
/* ------------------------------------------------------------------------- */

void TerminalDisplay::sendToShell(const QByteArray &bytes)
{
	if (bytes.isEmpty())
		return;
	writeInputBytes(bytes.constData(), bytes.size());
}

void TerminalDisplay::toggleCommandPanel()
{
	if (!_cmdPanel) {
		_cmdPanel = new CCommandPanel(this);
		connect(_cmdPanel, SIGNAL(commandChosen(QString,bool)),
		        this, SLOT(onQuickCommand(QString,bool)));
		connect(_cmdPanel, SIGNAL(sshChosen(QString,QString,int,QString,QString)),
		        this, SLOT(runSshConnection(QString,QString,int,QString,QString)));
	}

	if (_cmdPanel->isOpen())
		_cmdPanel->dismiss();
	else
		_cmdPanel->popup();
}

void TerminalDisplay::onQuickCommand(const QString &command, bool run)
{
	if (_cmdPanel)
		_cmdPanel->dismiss();

	// A saved snippet may contain line breaks; the pty wants a carriage return
	// for each of them, just like pressing Enter.
	QString text = command;
	text.replace("\r\n", "\n");
	text.replace('\n', '\r');

	QByteArray bytes = text.toUtf8();
	if (run)
		bytes.append('\r');
	sendToShell(bytes);
	setFocus();
}

void TerminalDisplay::runSshConnection(const QString &user, const QString &host,
                                       int port, const QString &identity,
                                       const QString &password)
{
    // accept-new only exists from OpenSSH 7.6 on.  An older client would stop
    // at an interactive "yes/no" and the phone has no comfortable way to answer
    // it, so fall back to plain "no" and keep our own known_hosts file.
    const bool acceptNew = (gSshMajor > 7) || (gSshMajor == 7 && gSshMinor >= 6);
    const QString knownHosts =
        QDir::current().absoluteFilePath(QString("data/.ssh/known_hosts"));

    // Reading the password off /dev/tty is the fragile part: the sandbox does
    // not always hand a controlling terminal to the child, and when it fails
    // ssh gives up on the password method *without ever asking* - the user
    // just sees "Permission denied (publickey,password)".  SSH_ASKPASS pushes
    // the secret through a helper program instead, so the prompt is optional.
    QString askpassPrefix;
    const QString askpassPass =
        QDir::current().absoluteFilePath(QString("data/.ssh/askpass.pass"));
    if (!password.isEmpty()) {
        const QString sshDir = QDir::current().absoluteFilePath(QString("data/.ssh"));
        QDir().mkpath(sshDir);
        const QString shFile = sshDir + "/askpass.sh";

        QFile pf(askpassPass);
        if (pf.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
            pf.write(password.toUtf8());
            pf.write("\n");
            pf.close();
            pf.setPermissions(QFile::ReadOwner | QFile::WriteOwner);
        }

        // The script carries the path, never the password, so nothing secret
        // shows up in the shell command line (which stays in the scrollback
        // and, worse, in bash's history file).
        const QByteArray body = "#!/bin/sh\ncat '" + askpassPass.toUtf8() + "'\n";
        QFile sf(shFile);
        bool need = true;
        if (sf.open(QIODevice::ReadOnly)) {
            need = (sf.readAll() != body);
            sf.close();
        }
        if (need && sf.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
            sf.write(body);
            sf.close();
            sf.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner);
        }
        // REQUIRE=force is OpenSSH 8.4+; older clients ignore it and fall back
        // to the tty prompt, which is no worse than before.
        askpassPrefix = "SSH_ASKPASS='" + shFile + "' SSH_ASKPASS_REQUIRE=force"
                        " DISPLAY=:0 ";
    }

    // Password auth only works end to end with a client that understands
    // SSH_ASKPASS_REQUIRE (8.4+).  The system client on BB10 is ancient and
    // silently falls back to the tty prompt - which is exactly the "nothing
    // happens, then Permission denied" behaviour - so whenever a password is
    // involved we drive our own bundled OpenSSH instead of PATH.
    QString sshBin = "ssh";
    QString libPrefix;
    {
        const QString bundled =
            QDir::current().absoluteFilePath(QString("app/native/bin/ssh"));
        const QString bundledLib =
            QDir::current().absoluteFilePath(QString("app/native/lib"));
        if (!password.isEmpty() && QFile::exists(bundled)) {
            sshBin = "'" + bundled + "'";
            libPrefix = "LD_LIBRARY_PATH='" + bundledLib + "':\"$LD_LIBRARY_PATH\" ";
        }
    }

    // -v into a file (-E) keeps the screen readable while still leaving a
    // trace of what the authentication phase actually tried; a bare
    // "Permission denied" carries no information at all.
    const QString sshLog =
        QDir::current().absoluteFilePath(QString("data/ssh.log"));
    if (QFileInfo(sshLog).size() > 262144)
        QFile::remove(sshLog);

    QString cmd = askpassPrefix + libPrefix + sshBin +
                  QString(" -v -E '%1'"
                          " -o StrictHostKeyChecking=%2"
                          " -o UserKnownHostsFile='%3'")
                      .arg(sshLog, acceptNew ? "accept-new" : "no", knownHosts);
    cmd += " -o ServerAliveInterval=30"   // keep the link alive
           " -o ServerAliveCountMax=3"    // ~90 s before giving up
           " -o TCPKeepAlive=yes";
    if (!password.isEmpty()) {
        // A typed password means the user wants password auth: trying public
        // keys first only burns the server's MaxAuthTries, and when the budget
        // runs out ssh reports "Permission denied" before it ever asks.
        cmd += " -o PubkeyAuthentication=no";
        // One shot: a wrong password should say so once, not hammer the host
        // three times (fail2ban counts those).
        cmd += " -o NumberOfPasswordPrompts=1";
    }
    if (port > 0 && port != 22)
        cmd += QString(" -p %1").arg(port);
    if (!identity.isEmpty()) {
        QString key = identity;
        // Relative paths are written the way the user thinks of them
        // ("data/.ssh/id_rsa"); ssh would resolve them against its own cwd.
        if (QFileInfo(key).isRelative())
            key = QDir::current().absoluteFilePath(key);
        QFile kf(key);
        if (kf.exists()) {
            // ssh silently refuses keys anyone else can read.
            kf.setPermissions(QFile::ReadOwner | QFile::WriteOwner);
            cmd += " -i '" + key + "'";
            // Otherwise the agent's keys are offered first and the server may
            // drop the connection with "too many authentication failures" -
            // which looks exactly like "the key I typed does nothing".
            cmd += " -o IdentitiesOnly=yes";
        } else {
            qDebug() << "ssh: identity file not found:" << key;
        }
    }
    if (!user.isEmpty())
        cmd += " " + user + "@" + host;
    else
        cmd += " " + host;

    if (_cmdPanel)
        _cmdPanel->dismiss();

    sendToShell(cmd.toUtf8());
    sendToShell(QByteArray(1, '\r'));

    _sshTail.clear();
    _sshPwdTries = 0;

    // Remembered so the dropped-connection banner can offer "重连" without
    // the user retyping anything.
    _lastSshCmd      = cmd;
    _lastSshUser     = user;
    _lastSshHost     = host;
    _lastSshPort     = port;
    _lastSshIdentity = identity;
    _lastSshPassword = password;
    _dcShown         = false;
    _sshDiagShown    = false;
    _sshTailForDiag.clear();
    _dcTail.clear();
    hideDisconnectBanner();
    if (!password.isEmpty()) {
        _sshPendingPwd = password;
        if (!_sshPwdTimer) {
            _sshPwdTimer = new QTimer(this);
            _sshPwdTimer->setSingleShot(true);
            connect(_sshPwdTimer, SIGNAL(timeout()),
                    this, SLOT(clearPendingSshPassword()));
        }
        _sshPwdTimer->start(60000);
    } else {
        _sshPendingPwd.clear();
    }
    setFocus();
}

void TerminalDisplay::clearPendingSshPassword()
{
	_sshPendingPwd.clear();
	_sshTail.clear();
	if (_sshPwdTimer)
		_sshPwdTimer->stop();
	// The askpass helper has a second reason to exist after this: leaving the
	// plaintext password on the flash for the rest of the session is not worth
	// a feature nobody is using any more.
	QFile::remove(QDir::current().absoluteFilePath(QString("data/.ssh/askpass.pass")));
}

// ---------------------------------------------------------------------------
// Dropped-connection banner: a thin strip along the top that says the session
// is gone and offers to run the very same ssh command again.
// ---------------------------------------------------------------------------
void TerminalDisplay::buildDisconnectBanner()
{
	if (_dcBanner)
		return;

	QFrame *frame = new QFrame(this);
	frame->setObjectName(QString("dcBanner"));
	// Translucent so the rounded corners really round (the terminal keeps
	// painting underneath) instead of showing four grey square corners.
	frame->setAttribute(Qt::WA_TranslucentBackground, true);
	frame->setAutoFillBackground(false);
	frame->setStyleSheet(QString(
	    "QFrame#dcBanner { background-color: rgba(36, 28, 12, 240);"
	    " border: 1px solid #6b5620; border-radius: 18px; }"
	    "QLabel { color: #f2cc60; font-size: 21px; }"
	    "QPushButton { background-color: #00e05a; color: #04140a;"
	    "  border: none; border-radius: 12px; padding: 8px 20px;"
	    "  font-size: 22px; font-weight: bold; }"
	    "QPushButton:pressed { background-color: #00c24e; }"
	    "QPushButton#dcClose { background-color: transparent;"
	    "  color: #8d9aa7; font-size: 26px; padding: 0px; }"));

	QHBoxLayout *lay = new QHBoxLayout(frame);
	lay->setContentsMargins(18, 8, 12, 8);
	lay->setSpacing(10);

	_dcLabel = new QLabel(QString::fromUtf8("连接已断开"), frame);
	QPushButton *btnReconnect = new QPushButton(QString::fromUtf8("重连"), frame);
	btnReconnect->setFocusPolicy(Qt::NoFocus);
	btnReconnect->setMinimumHeight(38);
	QPushButton *btnClose = new QPushButton(QString::fromUtf8("×"), frame);
	btnClose->setObjectName(QString("dcClose"));
	btnClose->setFocusPolicy(Qt::NoFocus);
	btnClose->setFixedSize(38, 38);

	lay->addWidget(_dcLabel, 1);
	lay->addWidget(btnReconnect, 0);
	lay->addWidget(btnClose, 0);

	connect(btnReconnect, SIGNAL(clicked()), this, SLOT(onDisconnectReconnect()));
	connect(btnClose,     SIGNAL(clicked()), this, SLOT(onDisconnectDismiss()));

	_dcBanner = frame;
	_dcBanner->hide();
}

void TerminalDisplay::layoutDisconnectBanner()
{
	if (!_dcBanner)
		return;

	int w = rect().width() - 16;
	if (w > 520) w = 520;
	if (w < 240) w = 240;
	_dcBanner->setGeometry((rect().width() - w) / 2, 10, w, 54);
}

void TerminalDisplay::showDisconnectBanner()
{
	buildDisconnectBanner();
	layoutDisconnectBanner();
	if (_dcLabel && !_lastSshHost.isEmpty())
		_dcLabel->setText(QString::fromUtf8("连接已断开：%1").arg(_lastSshHost));
	_dcBanner->show();
	_dcBanner->raise();
}

void TerminalDisplay::hideDisconnectBanner()
{
	if (_dcBanner && _dcBanner->isVisible())
		_dcBanner->hide();
}

void TerminalDisplay::onDisconnectReconnect()
{
	hideDisconnectBanner();
	if (_lastSshCmd.isEmpty())
		return;

	// Same host, same key; a stored password is armed again for the new
	// prompt by runSshConnection().
	runSshConnection(_lastSshUser, _lastSshHost, _lastSshPort,
	                 _lastSshIdentity, _lastSshPassword);
}

void TerminalDisplay::onDisconnectDismiss()
{
	hideDisconnectBanner();
	setFocus();
}

void TerminalDisplay::showSshDiagnostics()
{
	const QString log = QDir::current().absoluteFilePath(QString("data/ssh.log"));
	if (!QFile::exists(log))
		return;
	// Typed at the prompt on purpose: the user is looking at that spot, and the
	// lines stay in the scrollback where they can be read or copied.
	sendToShell(QByteArray(1, '\r'));
	sendToShell(QString("tail -n 30 '" + log + "'").toUtf8());
	sendToShell(QByteArray(1, '\r'));
	setFocus();
}

// ssh asks for the password on the tty, not through a helper process, so the
// answer has to come from whoever owns the pty: this widget. The prompt can
// arrive split over two reads, hence the small tail buffer.
void TerminalDisplay::onSessionOutput(const QString &text)
{
	// --- dropped connection --------------------------------------------
	// ssh says one of these on its way out; catching it here saves the user
	// from having to spot the line in the scrollback and retype the command.
	// Only armed once an ssh session was started from this widget.
	if (!_lastSshCmd.isEmpty() && !_dcShown) {
		_dcTail += text;
		if (_dcTail.size() > 256)
			_dcTail = _dcTail.right(256);
		const QString low = _dcTail.toLower();
		const bool dropped =
			low.contains(QString("connection closed")) ||
			low.contains(QString("connection reset")) ||
			low.contains(QString("broken pipe")) ||
			low.contains(QString("disconnected from")) ||
			(low.contains(QString("connection to ")) &&
			 low.contains(QString(" closed")));
		if (dropped) {
			_dcShown = true;
			_dcTail.clear();
			showDisconnectBanner();
		}
	}

	if (_sshPendingPwd.isEmpty())
		return;

	// Authentication ended in failure.  "Permission denied" on its own does not
	// say whether the password was wrong, never sent, or drowned out by public
	// keys, so pull the tail of the ssh -v log onto the screen.
	if (!_sshDiagShown && !_lastSshCmd.isEmpty()) {
		_sshTailForDiag += text.toLower();
		if (_sshTailForDiag.size() > 256)
			_sshTailForDiag = _sshTailForDiag.right(256);
		if (_sshTailForDiag.contains(QString("permission denied"))) {
			_sshDiagShown = true;
			_sshTailForDiag.clear();
			QTimer::singleShot(500, this, SLOT(showSshDiagnostics()));
		}
	}

	_sshTail += text.toLower();
	if (_sshTail.size() > 64)
		_sshTail = _sshTail.right(64);

	if (!_sshTail.contains(QString("password")) &&
	    !_sshTail.contains(QString::fromUtf8("\u5bc6\u7801")))
		return;

	QByteArray pwd = _sshPendingPwd.toUtf8();
	pwd.append('\r');
	writeInputBytes(pwd.constData(), pwd.size());
	// A wrong password just re-prompts; allow a couple of retries and
	// only then forget it, otherwise the first typo disables the feature
	// for the rest of the session.
	_sshTail.clear();
	if (++_sshPwdTries >= 3)
		clearPendingSshPassword();
}

bool TerminalDisplay::handleImeKey(QKeyEvent* event)
{
	if (!_imeOn || !_ime)
		return false;

	// A commit empties the composition at once, but the echo of the
	// character is still a pty round trip away. Keys that auto-repeat in
	// that window (Space held down while picking a word, mostly) belong to
	// the word that was just committed, not to the shell: letting them
	// through is what produced the stray spaces and line breaks.
	if (event->isAutoRepeat() && event->key() == Qt::Key_Space &&
	    QDateTime::currentMSecsSinceEpoch() - _imeCommitMs < IME_COMMIT_GUARD_MS)
		return true;

	// Ctrl / Alt chords keep their meaning (Alt+Enter is the toggle itself),
	// so they never reach the pinyin buffer.
	if (event->modifiers() & (Qt::ControlModifier | Qt::AltModifier))
		return false;

	// The letters are kept aside as they were typed (the engine lowercases
	// its own pinyin buffer), so Enter can flush them as plain English with
	// the original case. Nothing is left to flush once the composition is
	// gone, so a stale buffer can never leak into a later word.
	if (cjk_ime_preedit(_ime)[0] == '\0')
		_imeRaw.clear();

	// While a composition runs the arrows steer the strip: left/right step the
	// highlight, up/down turn the page. Without a composition they keep their
	// normal job, so the shell still gets them.
	if (_imePanel && _imePanel->isOpen() && cjk_ime_preedit(_ime)[0] != '\0') {
		switch (event->key()) {
		case Qt::Key_Left:  _imePanel->moveHighlight(-1); event->accept(); return true;
		case Qt::Key_Right: _imePanel->moveHighlight(+1); event->accept(); return true;
		case Qt::Key_Up:    onImePageRequested(-1);       event->accept(); return true;
		case Qt::Key_Down:  onImePageRequested(+1);       event->accept(); return true;
		default: break;
		}
	}

	// Space takes the highlighted candidate (candidate 1 when nothing was
	// steered to), the way a desktop input method does.
	if (event->key() == Qt::Key_Space && cjk_ime_preedit(_ime)[0] != '\0') {
		// Take the highlighted candidate. If the strip has nothing laid out
		// (or is closed) fall back to candidate 1 instead of swallowing the
		// key - a dead Space makes people hit it again, which is exactly how
		// junk ended up in the shell.
		if (_imePanel && _imePanel->hasHighlight())
			_imePanel->commitHighlighted();
		else
			sendImeSym('1');
		_imeRaw.clear();
		_imeCommitMs = QDateTime::currentMSecsSinceEpoch();
		event->accept();
		return true;
	}

	// Enter while composing sends what was typed as plain English, exactly as
	// typed (case included) and with nothing appended: an English word then
	// needs no 中/EN toggle, and a composition can never be turned into a
	// Chinese character by accident. No newline is sent - the composition
	// ends, so a second Enter (nothing composing now) runs the line.
	if ((event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter) &&
	    cjk_ime_preedit(_ime)[0] != '\0') {
		QByteArray raw = _imeRaw.isEmpty()
		                 ? QByteArray(cjk_ime_preedit(_ime))
		                 : _imeRaw.toUtf8();
		imeTraceBytes("ime-enter-flush", raw.constData(), raw.size());
		writeInputBytes(raw.constData(), raw.size());
		cjk_ime_reset(_ime);
		_imeRaw.clear();
		_imeCommitMs = QDateTime::currentMSecsSinceEpoch();
		refreshImePanel();
		event->accept();
		return true;
	}

	int sym = imeSymForEvent(event);

	// With no composition running, only a letter may start one.  Everything
	// else - Space, Backspace, Enter, digits, punctuation, Esc - belongs to the
	// application.  The engine happily reports "consumed" for those (it reads
	// them as "end of composition") while emitting no byte at all, so a TUI
	// like Claude Code never receives the key and the screen just sits there,
	// which reads as "nothing gets redrawn".  Ctrl chords never get here.
	if (cjk_ime_preedit(_ime)[0] == '\0') {
		const bool letter = (sym >= 'a' && sym <= 'z') ||
		                    (sym >= 'A' && sym <= 'Z');
		if (!letter)
			return false;
	}

	// Keep the letters as typed (case included) for the Enter flush above;
	// Backspace takes the last one back out so the flush always matches the
	// candidate strip.
	if ((sym >= 'a' && sym <= 'z') || (sym >= 'A' && sym <= 'Z')) {
		const QString typed = event->text();
		_imeRaw.append(typed.size() == 1 ? typed : QString(QChar(sym)));
	} else if (sym == 0x7f && !_imeRaw.isEmpty()) {
		_imeRaw.chop(1);
	}

	// A page key with nothing to turn is just punctuation: marking it unused
	// drops into the branch below, which sends the letters typed so far and
	// then lets the shell have the `,` itself.
	if (sym != 0 &&
	    imePageKeyHasNoPage(sym, cjk_ime_preedit(_ime)[0] != '\0',
	                         cjk_ime_candidate_page_count(_ime)))
		sym = 0;

	if (sym == 0) {
		// A key the engine cannot use (punctuation, a function key) ends the
		// composition, but the letters typed so far are not dropped with it:
		// they go out first, in the order they were typed, so "Hello!" cannot
		// lose its "Hello". The key itself then reaches the shell untouched.
		if (cjk_ime_preedit(_ime)[0] != '\0') {
			if (!_imeRaw.isEmpty()) {
				const QByteArray raw = _imeRaw.toUtf8();
				imeTraceBytes("ime-flush", raw.constData(), raw.size());
				writeInputBytes(raw.constData(), raw.size());
			}
			cjk_ime_reset(_ime);
			_imeRaw.clear();
			_imeCommitMs = QDateTime::currentMSecsSinceEpoch();
			refreshImePanel();
		}
		return false;
	}

	char out[192];
	size_t outLen = 0;
	const int r = cjk_ime_handle_key(_ime, sym, 0, 1, out, sizeof(out), &outLen);

	if (r == 2 && outLen > 0) {
		imeTraceBytes("ime-commit-key", out, (int)outLen);
		writeInputBytes(out, (int)outLen);
		_imeCommitMs = QDateTime::currentMSecsSinceEpoch();
	}
	if (cjk_ime_preedit(_ime)[0] == '\0')
		_imeRaw.clear();        // committed, cancelled, or deleted back to empty
	refreshImePanel();
	if (r == 2)
		update();               // repaint now instead of waiting for the echo

	if (r == 0)
		return false;           // engine did not use it: the shell gets the key

	event->accept();
	return true;
}

void TerminalDisplay::keyPressEvent( QKeyEvent* event )
{
//qDebug("+++%s %d keyPressEvent and key is %d, modifiers=%x", __FILE__, __LINE__, event->key(), int(event->modifiers()));

	// Typing anything means the user has moved on (usually by starting a new
	// ssh by hand), so the "连接已断开" strip has done its job.
	if (_dcBanner && _dcBanner->isVisible())
		hideDisconnectBanner();

	// Alt+Enter switches the pinyin input method (中 / EN).
	if (event->modifiers() == Qt::AltModifier &&
	    (event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter)) {
		toggleImeMode();
		event->accept();
		return;
	}

	// Ctrl+Space is NOT a shortcut here any more: on a phone keyboard it is
	// far too easy to hit by accident, and one stray chord used to leave the
	// IME on for the whole session (letters swallowed as pinyin, shell looks
	// dead). It now goes to the shell like every other Ctrl chord.

	// Tab is missing from the BB10 layouts; it moved to Alt+Space now that
	// Alt+Enter belongs to the input method.
	if (event->modifiers() == Qt::AltModifier && event->key() == Qt::Key_Space) {
		char tab = 0x09;
		writeInputBytes(&tab, 1);
		event->accept();
		return;
	}

	// Term50 chord: shift+alt+<key> = Ctrl+<key> (physical keyboard)
	if (event->modifiers() == (Qt::ShiftModifier | Qt::AltModifier) &&
	    event->key() >= 0x40 && event->key() <= 0x5f) {
		char cc = (char)(event->key() - 0x40);
		writeInputBytes(&cc, 1);
		event->accept();
		return;
	}

	// --- Shift: the left one stays a plain Shift ----------------------
	// The BB10 phone keyboards (Q10/Q30/Passport/Classic) have no Ctrl key,
	// so only the RIGHT Shift lends us one. The left Shift must keep behaving
	// exactly as it always did (uppercase, and the BB10 shift/SYM workaround
	// below) - it is never allowed to turn into Ctrl.
	//
	// Right Shift is a plain modifier: down = Ctrl on, up = Ctrl off.  There
	// is no double-tap latch, so tapping it twice in a row (or tapping it
	// once by accident) sends nothing and changes nothing on screen.
	if (event->key() == Qt::Key_Shift) {
		const bool right = td_isRightShift(event);
		_lastShiftNative   = event->nativeVirtualKey();
		_lastShiftScan     = event->nativeScanCode();
		_lastShiftWasRight = right;

		if (right) {
			_ctrlHeld = true;   // hold right Shift = hold Ctrl, nothing is sent
			event->accept();
			return;
		}
	}

	// right Shift is still held: this key is Ctrl+<key>
	if (_ctrlHeld) {
		sendCtrlKey(event);
		event->accept();
		return;
	}

	// --- pinyin IME -----------------------------------------------------
	// While it is on, a-z build the pinyin buffer while 1-9, 0 and < > work
	// the candidate strip. Ctrl/Alt chords, the sticky CTRL layer and the
	// SYM grid were handled above and keep priority.
	if (_imeOn) {
		const int preNow = _ime ? (int)cjk_ime_preedit(_ime)[0] : 0;
		const bool imeUsed = handleImeKey(event);
		imeTraceKey(imeUsed ? "ime-used" : "ime-pass", event, preNow);
		if (imeUsed)
			return;
	}

	// --- SYM key: the Term50 symmenu overlay ---------------------------
	// The physical SYM key is QNX keycode 0xF0d3 (Term50 KEYCODE_BB_SYM_KEY);
	// Qt has no mapping for it, and Q10 firmware delivers a bare Escape
	// instead - accepted as a fallback, because the phones have no Escape
	// key of their own (Esc lives on the CTRL layer).
	const bool symKey = (event->nativeVirtualKey() == TD_KEYCODE_BB_SYM ||
	                     event->nativeScanCode()   == TD_KEYCODE_BB_SYM);
	const bool bareEsc = (event->key() == Qt::Key_Escape &&
	                      event->modifiers() == Qt::NoModifier &&
	                      event->text().isEmpty());

	if (_symPanel && _symPanel->isOpen()) {
		// while the grid is up it owns the keyboard: a bound letter picks a
		// symbol (Term50 keymap_lookup), SYM/Esc closes it, anything else
		// closes it and is swallowed so a stray key cannot leak into the shell.
		if (symKey || bareEsc)
			closeSymbolPanel();
		else if (CSymbolPanel::hasKey(event->key()))
			insertSymbolText(CSymbolPanel::textForKey(event->key()));
		else
			closeSymbolPanel();
		event->accept();
		return;
	}

	if (symKey || bareEsc) {
		showSymbolPanel();
		event->accept();
		return;
	}

	if (event->key() == Qt::Key_Shift){
	    if (bShiftFlag)
	        bShiftFlag = false;
	    else
	        bShiftFlag = true;
        }
	if (int(event->modifiers()) == Qt::AltModifier){
		// When single Alt was pressed we get key=1000023 and modifiers = 0, we don't need this event here
		// if then a key pressed we get key=KEY_CODE and modifiers = Qt::AltModifier
		// Alt was pressed we need to treat it differently -(
		char c = 0;
		switch(event->key()){
		case Qt::Key_Q : c = 35; break;
		case Qt::Key_W : c = 49; break;
		case Qt::Key_E : c = 50; break;
		case Qt::Key_R : c = 51; break;
		case Qt::Key_T : c = 40; break;
		case Qt::Key_Y : c = 41; break;
		case Qt::Key_U : c = 95; break;
		case Qt::Key_I : c = 45; break;
		case Qt::Key_O : c = 43; break;
		case Qt::Key_P : c = 64; break;
		case Qt::Key_A : c = 42; break;
		case Qt::Key_S : c = 52; break;
		case Qt::Key_D : c = 53; break;
		case Qt::Key_F : c = 54; break;
		case Qt::Key_G : c = 47; break;
		case Qt::Key_H : c = 58; break;
		case Qt::Key_J : c = 59; break;
		case Qt::Key_K : c = 39; break;
		case Qt::Key_L : c = 34; break;
		case Qt::Key_Z : c = 55; break;
		case Qt::Key_X : c = 56; break;
		case Qt::Key_C : c = 57; break;
		case Qt::Key_V : c = 63; break;
		case Qt::Key_B : c = 33; break;
		case Qt::Key_N : c = 44; break;
		case Qt::Key_M : c = 46; break;
		case Qt::Key_Dollar : c = 96; break;
		case 0x30 : c = '0'; break;
		}
		if (c != 0)
			writeInputBytes(&c, 1);
		return;
	}

	// Let's treat 'Soft' Ctrl+ case here. The on-screen Ctrl+ button is gone;
	// the legacy flag is kept only for the remaining call sites.
	if (bCtrlFlag){
		bCtrlFlag = false;
		char c = 0x0;
		if (event->key() < 0x60 && event->key() > 0x40){
			c = event->key() - 0x40;
			writeInputBytes(&c, 1);
		}
		return;
	}
	if (event->key() == Qt::Key_Tab){
		char c = 9;
		writeInputBytes(&c, 1);
		return;
	}
	if (event->key() == Qt::Key_Escape){
		char c = 0x1B;
		writeInputBytes(&c, 1);
		return;
	}
    bool emitKeyPressSignal = true;

    // XonXoff flow control
    if ((event->modifiers() & Qt::ControlModifier) && _flowControlWarningEnabled)
	{
		if ( event->key() == Qt::Key_S ) {
		//qDebug("%s %d keyPressEvent, output suspended", __FILE__, __LINE__);
				emit flowControlKeyPressed(true /*output suspended*/);
		}
		else if ( event->key() == Qt::Key_Q ) {
		//qDebug("%s %d keyPressEvent, output enabled", __FILE__, __LINE__);
				emit flowControlKeyPressed(false /*output enabled*/);
		}
	}

    // Shift+PageUp/PageDown on the alternate screen: the local history is
    // empty, so forward the keys the pager actually listens for instead of
    // scrolling a zero-range bar.
    if ( event->modifiers() == Qt::ShiftModifier && _screenWindow &&
         _screenWindow->screen() && _screenWindow->screen()->isAlternateScreen() &&
         ( event->key() == Qt::Key_PageUp || event->key() == Qt::Key_PageDown ) )
    {
        const char pgup[4]   = { 0x1b, '[', '5', '~' };
        const char pgdown[4] = { 0x1b, '[', '6', '~' };
        writeInputBytes(event->key() == Qt::Key_PageUp ? pgup : pgdown, 4);
        event->accept();
        return;
    }

    // Keyboard-based navigation
    if ( event->modifiers() == Qt::ShiftModifier )
    {
        bool update = true;

        if ( event->key() == Qt::Key_PageUp )
        {
	    //qDebug("%s %d pageup", __FILE__, __LINE__);
            _screenWindow->scrollBy( ScreenWindow::ScrollPages , -1 );
        }
        else if ( event->key() == Qt::Key_PageDown )
        {
	    //qDebug("%s %d pagedown", __FILE__, __LINE__);
            _screenWindow->scrollBy( ScreenWindow::ScrollPages , 1 );
        }
        else if ( event->key() == Qt::Key_Up )
        {
	    //qDebug("%s %d keyup", __FILE__, __LINE__);	
            _screenWindow->scrollBy( ScreenWindow::ScrollLines , -1 );
        }
        else if ( event->key() == Qt::Key_Down )
        {
	    //qDebug("%s %d keydown", __FILE__, __LINE__);	
            _screenWindow->scrollBy( ScreenWindow::ScrollLines , 1 );
        }
        else {
            update = false;
	}

        if ( update )
        {
	    //qDebug("%s %d updating", __FILE__, __LINE__);	
            _screenWindow->setTrackOutput( _screenWindow->atEndOfOutput() );
            
            updateLineProperties();
            updateImage();

            // do not send key press to terminal
            emitKeyPressSignal = false;
        }
    }
    
    _screenWindow->setTrackOutput( true );
    
    _actSel=0; // Key stroke implies a screen update, so TerminalDisplay won't
              // know where the current selection is.

    if (_hasBlinkingCursor) 
    {
      _blinkCursorTimer->start(BLINK_DELAY);
      if (_cursorBlinking)
        blinkCursorEvent();
      else
        _cursorBlinking = false;
    }

    if ( emitKeyPressSignal )
    {
        if (bShiftFlag && dtDevice == BB_PASSPORT){
            // Stack object: the old code heap-allocated the key event and
            // nobody ever deleted it, so every capital letter typed on a
            // Passport leaked one QKeyEvent.
            QKeyEvent event_caps(QEvent::KeyPress, event->key(),
                                 event->modifiers(), event->text().toUpper());
            emit keyPressedSignal(&event_caps);
        }else{
            emit keyPressedSignal(event);
        }
    }

    event->accept();
}

void TerminalDisplay::inputMethodEvent( QInputMethodEvent* event )
{
    QKeyEvent keyEvent(QEvent::KeyPress,0,Qt::NoModifier,event->commitString());
    emit keyPressedSignal(&keyEvent);

    _inputMethodData.preeditString = event->preeditString();
    update(preeditRect() | _inputMethodData.previousPreeditRect);
    
    event->accept();
}
QVariant TerminalDisplay::inputMethodQuery( Qt::InputMethodQuery query ) const
{
    const QPoint cursorPos = _screenWindow ? _screenWindow->cursorPosition() : QPoint(0,0);
    switch ( query ) 
    {
        case Qt::ImMicroFocus:
                return imageToWidget(QRect(cursorPos.x(),cursorPos.y(),1,1));
            break;
        case Qt::ImFont:
                return font();
            break;
        case Qt::ImCursorPosition:
                // return the cursor position within the current line
                return cursorPos.x();
            break;
        case Qt::ImSurroundingText:
            {
                // return the text from the current line
                // A cursor sitting on the last row, or a line whose
                // properties have not been filled in yet, used to index
                // _lineProperties[] out of bounds - the IME query is called by
                // the framework at arbitrary moments, so this has to be
                // guarded rather than assumed.
                const int cy = cursorPos.y();
                if (!_image || cy < 0 || cy >= _usedLines)
                    return QString();

                QString lineText;
                QTextStream stream(&lineText);
                PlainTextDecoder decoder;
                decoder.begin(&stream);
                const quint8 props = (cy < _lineProperties.size())
                                     ? _lineProperties.at(cy) : 0;
                decoder.decodeLine(&_image[loc(0,cy)],_usedColumns,props);
                decoder.end();
                return lineText;
            }
            break;
        case Qt::ImCurrentSelection:
                return QString();
            break;
    }

    return QVariant();
}

bool TerminalDisplay::event( QEvent *e )
{
//+++qDebug()<<"TerminalDisplay::event() type="<<e->type();
//+++fprintf(stderr, "TerminalDisplay::event() type=%d\n", e->type());
  if ( e->type() == QEvent::ShortcutOverride )
  {
    QKeyEvent* keyEvent = static_cast<QKeyEvent *>( e );

    // a check to see if keyEvent->text() is empty is used
    // to avoid intercepting the press of the modifier key on its own.
    //
    // this is important as it allows a press and release of the Alt key
    // on its own to focus the menu bar, making it possible to
    // work with the menu without using the mouse
    if ( (keyEvent->modifiers() == Qt::AltModifier) && 
         !keyEvent->text().isEmpty() )
    {
    	keyEvent->accept();
      	return true;
    }

    // Override any of the following shortcuts because
    // they are needed by the terminal
    int keyCode = keyEvent->key() | keyEvent->modifiers();
    switch ( keyCode )
    {
      // list is taken from the QLineEdit::event() code
      case Qt::Key_Tab:
      case Qt::Key_Delete:
      case Qt::Key_Home:
      case Qt::Key_End:
      case Qt::Key_Backspace:
      case Qt::Key_Left:
      case Qt::Key_Right:
        keyEvent->accept();
        return true;
    }
  }

  return QWidget::event( e );
}

void TerminalDisplay::setBellMode(int mode)
{
  _bellMode=mode;
}

void TerminalDisplay::enableBell()
{
    _allowBell = true;
}

void TerminalDisplay::bell(const QString&)
{
  if (_bellMode==NoBell) return;

  //limit the rate at which bells can occur 
  //...mainly for sound effects where rapid bells in sequence 
  //produce a horrible noise
  if ( _allowBell )
  {
    _allowBell = false;
    QTimer::singleShot(500,this,SLOT(enableBell()));
 
    if (_bellMode==SystemBeepBell) 
    {
//        KNotification::beep();
    } 
    else if (_bellMode==NotifyBell) 
    {
//        KNotification::event("BellVisible", message,QPixmap(),this);
    } 
    else if (_bellMode==VisualBell) 
    {
        swapColorTable();
        QTimer::singleShot(200,this,SLOT(swapColorTable()));
    }
  }
}

void TerminalDisplay::swapColorTable()
{
  ColorEntry color = _colorTable[1];
  _colorTable[1]=_colorTable[0];
  _colorTable[0]= color;
  _colorsInverted = !_colorsInverted;
  update();
}

void TerminalDisplay::clearImage()
{
  // We initialize _image[_imageSize] too. See makeImage()
  for (int i = 0; i <= _imageSize; i++)
  {
    _image[i].character = ' ';
    _image[i].foregroundColor = CharacterColor(COLOR_SPACE_DEFAULT,
                                               DEFAULT_FORE_COLOR);
    _image[i].backgroundColor = CharacterColor(COLOR_SPACE_DEFAULT,
                                               DEFAULT_BACK_COLOR);
    _image[i].rendition = DEFAULT_RENDITION;
  }
}

void TerminalDisplay::calcGeometry()
{
  _scrollBar->resize(QApplication::style()->pixelMetric(QStyle::PM_ScrollBarExtent),
                    contentsRect().height());
  switch(_scrollbarLocation)
  {
    case NoScrollBar :
     _leftMargin = DEFAULT_LEFT_MARGIN;
     _contentWidth = contentsRect().width() - 2 * DEFAULT_LEFT_MARGIN;
     break;
    case ScrollBarLeft :
     _leftMargin = DEFAULT_LEFT_MARGIN + _scrollBar->width();
     _contentWidth = contentsRect().width() - 2 * DEFAULT_LEFT_MARGIN - _scrollBar->width();
     _scrollBar->move(contentsRect().topLeft());
     break;
    case ScrollBarRight:
     _leftMargin = DEFAULT_LEFT_MARGIN;
     _contentWidth = contentsRect().width()  - 2 * DEFAULT_LEFT_MARGIN - _scrollBar->width();
     _scrollBar->move(contentsRect().topRight() - QPoint(_scrollBar->width()-1,0));
     break;
  }

  _topMargin = DEFAULT_TOP_MARGIN;
  _contentHeight = contentsRect().height() - 2 * DEFAULT_TOP_MARGIN + /* mysterious */ 1
                   - _bottomReserve - DEFAULT_BOTTOM_PAD;
  if (_contentHeight < _fontHeight)
     _contentHeight = _fontHeight;   // never collapse below a single row

  if (!_isFixedSize)
  {
     // ensure that display is always at least one column wide
     _columns = qMax(1,_contentWidth / _fontWidth);
     _usedColumns = qMin(_usedColumns,_columns);
     
     // ensure that display is always at least one line high
     _lines = qMax(1,_contentHeight / _fontHeight);
     _usedLines = qMin(_usedLines,_lines);
  }
}

void TerminalDisplay::makeImage()
{
//qDebug("%s %d makeImage", __FILE__, __LINE__);
  calcGeometry();

  // confirm that array will be of non-zero size, since the painting code 
  // assumes a non-zero array length
  Q_ASSERT( _lines > 0 && _columns > 0 );
  Q_ASSERT( _usedLines <= _lines && _usedColumns <= _columns );

  _imageSize=_lines*_columns;
  
  // We over-commit one character so that we can be more relaxed in dealing with
  // certain boundary conditions: _image[_imageSize] is a valid but unused position
  _image = new Character[_imageSize+1];

  clearImage();
}

// calculate the needed size
void TerminalDisplay::setSize(int columns, int lines)
{
  //FIXME - Not quite correct, a small amount of additional space
  // will be used for margins, the scrollbar etc.
  // we need to allow for this so that '_size' does allow
  // enough room for the specified number of columns and lines to fit

  QSize newSize = QSize( columns * _fontWidth  ,
				 lines * _fontHeight   );

  if ( newSize != size() )
  {
    _size = newSize;
    updateGeometry();
  }
}

void TerminalDisplay::setFixedSize(int cols, int lins)
{
  _isFixedSize = true;
  
  //ensure that display is at least one line by one column in size
  _columns = qMax(1,cols);
  _lines = qMax(1,lins);
  _usedColumns = qMin(_usedColumns,_columns);
  _usedLines = qMin(_usedLines,_lines);

  if (_image)
  {
     delete[] _image;
     makeImage();
  }
  setSize(cols, lins);
  QWidget::setFixedSize(_size);
}

QSize TerminalDisplay::sizeHint() const
{
  return _size;
}


