# bar-descriptor.xml 是 blackberry-nativepackager 的输入，要入库；
# assets/.assets.index 由打包器生成
*.bar
*.bar.bak
assets/.assets.index

# ── 本机临时文件 ───────────────────────────────────────────────
.tmp/
*.log
